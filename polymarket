        api_k = st.text_input("API key (auto-derived if blank)", value=creds.get("api_key", ""))
        api_s = st.text_input("API secret", value=creds.get("api_secret", ""), type="password")
        api_p = st.text_input("API passphrase", value=creds.get("api_passphrase", ""), type="password")
        if st.form_submit_button("Save credentials"):
            st.session_state["pm_creds"] = {
                "private_key": pk.strip(),
                "funder_address": funder.strip(),
                "signature_type": int(sig_type),
                "api_key": api_k.strip(),
                "api_secret": api_s.strip(),
                "api_passphrase": api_p.strip(),
            }
            save_json_file(PM_CREDS_FILE, st.session_state["pm_creds"])
            st.session_state["pm_client"] = None
            st.success("Saved. Click 'Test connection' to initialise CLOB.")

    if st.button("Test connection"):
        st.session_state["pm_client"] = None
        c = get_client()
        if c is None:
            st.error(f"Connection failed: {st.session_state['pm_client_error']}")
        else:
            try:
                ok = c.get_ok()
                st.success(f"CLOB reachable: {ok}")
            except Exception as e:
                st.warning(f"Client built, but health check failed: {e}")
            addr = get_user_address(st.session_state["pm_creds"])
            if addr:
                st.info(f"Address in use: {addr}")
