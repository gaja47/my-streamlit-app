def build_clob_client(creds):
    if not CLOB_AVAILABLE:
        raise RuntimeError(f"py_clob_client not installed: {CLOB_IMPORT_ERR}")
    private_key = (creds.get("private_key") or "").strip()
    if not private_key:
        raise RuntimeError("Private key not configured.")
    funder = (creds.get("funder_address") or "").strip() or None
    sig_type = int(creds.get("signature_type") or 0)
    kwargs = {"key": private_key, "chain_id": POLYGON_CHAIN_ID}
    if funder and sig_type:
        kwargs["signature_type"] = sig_type
        kwargs["funder"] = funder
    client = ClobClient(CLOB_HOST, **kwargs)
    api_key = (creds.get("api_key") or "").strip()
    api_secret = (creds.get("api_secret") or "").strip()
    api_pass = (creds.get("api_passphrase") or "").strip()
    if api_key and api_secret and api_pass:
        client.set_api_creds(ApiCreds(api_key=api_key, api_secret=api_secret, api_passphrase=api_pass))
    else:
        derived = client.create_or_derive_api_creds()
        client.set_api_creds(derived)
        creds["api_key"] = derived.api_key
        creds["api_secret"] = derived.api_secret
        creds["api_passphrase"] = derived.api_passphrase
        save_json_file(PM_CREDS_FILE, creds)
        st.session_state["pm_creds"] = creds
    return client


def get_client():
    if st.session_state["pm_client"] is not None:
        return st.session_state["pm_client"]
    try:
        c = build_clob_client(st.session_state["pm_creds"])
        st.session_state["pm_client"] = c
        st.session_state["pm_client_error"] = None
        return c
    except Exception as e:
        st.session_state["pm_client_error"] = repr(e)
        return None


# ---------- Market data helpers ----------
def gamma_search_markets(query, limit=20, active_only=True):
    params = {"limit": 100 if query else limit, "closed": "false"}
    if active_only:
        params["active"] = "true"
    try:
        r = requests.get(f"{GAMMA_API}/markets", params=params, timeout=10)
        r.raise_for_status()
        markets = r.json()
    except Exception as e:
        return [], repr(e)
    if query:
        q = query.lower()
        markets = [m for m in markets if q in (m.get("question") or "").lower()][:limit]
    return markets, None


def parse_json_field(val, default):
    if val is None:
        return default
    if isinstance(val, (list, dict)):
        return val
    try:
        return json.loads(val)
    except Exception:
        return default


def get_token_midpoint(token_id):
    try:
        r = requests.get(f"{CLOB_HOST}/midpoint", params={"token_id": token_id}, timeout=5)
        if r.ok:
            return float(r.json().get("mid") or 0)
    except Exception:
        return None
    return None


def get_user_address(creds):
    addr = (creds.get("funder_address") or "").strip()
    if addr:
        return addr
    pk = (creds.get("private_key") or "").strip()
    if not pk or not ETH_ACCOUNT_AVAILABLE:
        return ""
    try:
        if not pk.startswith("0x"):
            pk = "0x" + pk
        return Account.from_key(pk).address
    except Exception:
        return ""


def log_trade(entry):
    entry = dict(entry)
    entry.setdefault("ts", datetime.now(timezone.utc).isoformat())
    trades = load_json_file(PM_TRADES_FILE, [])
    trades.insert(0, entry)
    trades = trades[:500]
    save_json_file(PM_TRADES_FILE, trades)


def place_order(token_id, side, price, size_shares, question=""):
    """Returns (ok, message). Enforces kill switch, position cap, paper mode."""
    settings = st.session_state["pm_settings"]
    notional = float(price) * float(size_shares)
    base = {
        "token_id": str(token_id),
        "side": side,
        "price": float(price),
        "size": float(size_shares),
        "notional_usd": notional,
        "question": question,
    }
    if settings.get("kill_switch", True):
        log_trade({**base, "mode": "BLOCKED", "reason": "Kill switch ON"})
        return False, "Kill switch is ON — no orders placed."
    cap = float(settings.get("max_position_usd") or 0)
    if cap > 0 and notional > cap:
        log_trade({**base, "mode": "BLOCKED", "reason": f"notional > cap ${cap}"})
        return False, f"Notional ${notional:.2f} exceeds cap ${cap:.2f}."
    if settings.get("trading_mode", "Paper") == "Paper":
        log_trade({**base, "mode": "PAPER"})
        return True, f"PAPER order recorded: {side} {size_shares:.2f} @ {price}"
    client = get_client()
    if client is None:
        log_trade({**base, "mode": "LIVE_FAILED", "error": st.session_state["pm_client_error"]})
        return False, f"CLOB client not ready: {st.session_state['pm_client_error']}"
    try:
        oargs = OrderArgs(
            price=float(price),
            size=float(size_shares),
            side=BUY if str(side).upper() == "BUY" else SELL,
            token_id=str(token_id),
        )
        signed = client.create_order(oargs)
        resp = client.post_order(signed, OrderType.GTC)
        log_trade({**base, "mode": "LIVE", "response": str(resp)})
        return True, f"LIVE order submitted: {resp}"
    except Exception as e:
        log_trade({**base, "mode": "LIVE_FAILED", "error": repr(e)})
        return False, f"Order failed: {e}"


