def load_json_file(path, default):
    if os.path.exists(path):
        with open(path, "r") as f:
            try:
                return json.load(f)
            except json.JSONDecodeError:
                return default
    return default


def save_json_file(path, data):
    with open(path, "w") as f:
        json.dump(data, f, indent=2)


