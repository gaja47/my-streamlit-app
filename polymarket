            token_id = st.text_input("Token ID", value=st.session_state["manual_token_id"])
            question = st.text_input("Question (log only)", value=st.session_state["manual_question"])
            ac1, ac2, ac3, ac4 = st.columns(4)
            with ac1:
                a_side = st.selectbox("Side", ["BUY", "SELL"], key="strat_side")
            with ac2:
                a_trigger = st.selectbox("Trigger when px", ["<=", ">="], key="strat_trigger")
            with ac3:
                a_thr = st.number_input("Threshold", 0.001, 0.999, 0.30, 0.01, format="%.3f")
            with ac4:
                a_order_price = st.number_input("Order price", 0.001, 0.999, 0.30, 0.01, format="%.3f")
            a_size_usd = st.number_input(
                "Order size (USD notional)", 0.1, 1e6,
                float(st.session_state["pm_settings"].get("default_order_usd", 5.0)), 0.1,
            )
            add = st.form_submit_button("Add strategy")
            if add:
                if not token_id.strip():
                    st.error("Token ID required.")
                else:
                    strategies.append({
                        "name": name,
                        "token_id": token_id.strip(),
                        "question": question,
                        "side": a_side,
                        "trigger": a_trigger,
                        "threshold": float(a_thr),
                        "order_price": float(a_order_price),
                        "size_usd": float(a_size_usd),
                        "enabled": True,
                        "fired": False,
                        "last_price": None,
                        "last_check": None,
                        "last_message": "",
                    })
                    save_json_file(PM_STRATEGIES_FILE, strategies)
                    st.session_state["pm_strategies"] = strategies
                    st.success("Strategy added.")

    if strategies:
        for i, sdef in enumerate(list(strategies)):
            with st.container(border=True):
                c1, c2, c3, c4 = st.columns([2, 3, 3, 2])
                c1.write(f"**{sdef['name']}**")
                c2.write((sdef.get("question") or "")[:60])
                c3.write(
                    f"{sdef['side']} @ {sdef['order_price']}  •  "
                    f"trigger px {sdef['trigger']} {sdef['threshold']}  •  ${sdef['size_usd']}"
                )
                lp = sdef.get("last_price")
                lp_txt = f"{lp:.4f}" if isinstance(lp, (int, float)) else "—"
                c4.write(
                    f"on: {sdef['enabled']}  fired: {sdef['fired']}  px {lp_txt}"
                )
                bc1, bc2, bc3 = st.columns(3)
                if bc1.button("Toggle enabled", key=f"toggle_{i}"):
                    strategies[i]["enabled"] = not strategies[i]["enabled"]
                    save_json_file(PM_STRATEGIES_FILE, strategies)
                    st.rerun()
                if bc2.button("Reset fired", key=f"reset_{i}"):
                    strategies[i]["fired"] = False
                    save_json_file(PM_STRATEGIES_FILE, strategies)
                    st.rerun()
                if bc3.button("Delete", key=f"del_{i}"):
                    strategies.pop(i)
                    save_json_file(PM_STRATEGIES_FILE, strategies)
                    st.rerun()

    st.divider()
    pc1, pc2 = st.columns([1, 3])
    with pc1:
        poll = st.checkbox("Run poll loop", value=False, help="Blocks the Streamlit thread between polls.")
    with pc2:
        interval = st.slider(
            "Poll interval (sec)", 5, 120,
            int(st.session_state["pm_settings"].get("poll_interval_sec", 10)),
        )
    if poll:
        changed = False
        for i, sdef in enumerate(strategies):
            if not sdef.get("enabled") or sdef.get("fired"):
                continue
            px = get_token_midpoint(sdef["token_id"])
            strategies[i]["last_price"] = px
            strategies[i]["last_check"] = datetime.now(timezone.utc).isoformat()
            changed = True
            if px is None:
                continue
            t = sdef["trigger"]
            thr = sdef["threshold"]
            hit = (t == "<=" and px <= thr) or (t == ">=" and px >= thr)
            if hit:
                shares = sdef["size_usd"] / max(sdef["order_price"], 1e-6)
                ok, msg = place_order(
                    sdef["token_id"], sdef["side"], sdef["order_price"], shares,
                    question=sdef.get("question", ""),
                )
                strategies[i]["fired"] = True
                strategies[i]["enabled"] = False
                strategies[i]["last_message"] = msg
        if changed:
            save_json_file(PM_STRATEGIES_FILE, strategies)
            st.session_state["pm_strategies"] = strategies
        st.write(f"Last poll: {datetime.now(timezone.utc).isoformat()}")
        time.sleep(interval)
        st.rerun()

