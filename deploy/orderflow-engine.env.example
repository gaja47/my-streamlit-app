# ---- Order Flow Engine config (copy to /opt/orderflow-engine/orderflow-engine.env) ----

# Symbols to track. The FIRST symbol is the "primary" one the frontend renders.
SYMBOLS=NSE:NIFTY25JULFUT

# Feed source:
#   sim      -> synthetic book, NO credentials (use this to smoke-test the deploy)
#   opticore -> reuse opticore's live Fyers feed (set the integration vars below)
FEED_SOURCE=sim

# WebSocket gateway bind. Keep on localhost and expose via nginx TLS (-> wss://).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# Parquet capture (Build Step 1: bank data, validate edge offline before trusting signals)
RECORD=true
DATA_DIR=/opt/orderflow-engine/data

# ---- Opticore integration (fill in once OpticoreFeedSource is wired) ----
# How does opticore expose its already-working live Fyers feed?
#  (a) IPC: it publishes depth frames on a channel we subscribe to
# OPTICORE_FEED_URL=redis://127.0.0.1:6379/0
# OPTICORE_FEED_TOPIC=fyers.depth
#  (b) in-process import of opticore's feed client
# OPTICORE_PYTHONPATH=/opt/opticore
# Fyers credentials are NOT set here — they stay in opticore. The engine reuses
# opticore's authenticated feed; it must never hold Fyers secrets itself.
